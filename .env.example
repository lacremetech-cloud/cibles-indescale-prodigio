# ─── Front (exposées au navigateur, préfixe VITE_) ───────────────────────────
# Sans ces deux variables, l'app tourne en MODE DÉMO (lecture seule, données d'exemple).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Backend / fonctions serverless Vercel (SECRÈTES, jamais exposées) ────────
# Google Places API (New) — activer "Places API (New)" dans Google Cloud.
GOOGLE_PLACES_API_KEY=
# Supabase service role (écriture du cache d'enrichissement côté serveur).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Pappers (OPTIONNEL) — enrichissement dirigeant le moins cher ────────────
# 100 crédits gratuits à l'inscription (email pro). Données dirigeant + email/tél si publiés.
# Sans clé : on utilise déjà l'API Recherche d'entreprises (gouv, gratuite) pour le dirigeant.
PAPPERS_API_KEY=

# ─── Connecteur B2B payant (OPTIONNEL) — uniquement pour le PORTABLE du dirigeant ─────
# Le stack gratuit (Maps + gouv + Pappers + email site) ne donne pas le mobile perso.
# Laisser vide = portable vide. Choisir un provider : kaspr (mobile) ou dropcontact (email vérifié).
B2B_CONNECTOR=
DROPCONTACT_API_KEY=
KASPR_API_KEY=
