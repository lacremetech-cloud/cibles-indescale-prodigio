# ─── Front (exposées au navigateur, préfixe VITE_) ───────────────────────────
# Sans ces deux variables, l'app tourne en MODE DÉMO (lecture seule, données d'exemple).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Backend / fonctions serverless Vercel (SECRÈTES, jamais exposées) ────────
# Google Places API (New) — activer "Places API (New)" dans Google Cloud.
GOOGLE_PLACES_API_KEY=
# Supabase service role (écriture du cache d'enrichissement côté serveur).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Connecteur B2B (OPTIONNEL) — atteindre le dirigeant ─────────────────────
# Laisser vide = email/portable du dirigeant restent vides, LinkedIn = lien de recherche.
# Provider par défaut : dropcontact (le moins cher). Alternatives : kaspr.
B2B_CONNECTOR=dropcontact
DROPCONTACT_API_KEY=
KASPR_API_KEY=
